{
  "name": "just-bash-util",
  "version": "0.1.8",
  "description": "CLI command framework, config file discovery, and path utilities for just-bash",
  "type": "module",
  "license": "MIT",
  "author": "blindmansion",
  "repository": {
    "type": "git",
    "url": "https://github.com/blindmansion/just-bash-util.git"
  },
  "homepage": "https://github.com/blindmansion/just-bash-util",
  "bugs": {
    "url": "https://github.com/blindmansion/just-bash-util/issues"
  },
  "keywords": [
    "cli",
    "command",
    "config",
    "path",
    "just-bash",
    "parser",
    "framework"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./command": {
      "import": "./dist/command/index.js",
      "types": "./dist/command/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./path": {
      "import": "./dist/path/index.js",
      "types": "./dist/path/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "just-bash": "^2.9.6"
  }
}
